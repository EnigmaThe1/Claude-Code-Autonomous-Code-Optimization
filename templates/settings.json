{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "bashOutputMaxChars": 12000,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "taskOutputMaxChars": 12000
}
